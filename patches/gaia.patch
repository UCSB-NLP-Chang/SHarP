+DATASET_CACHE_DIR = Path(os.environ.get("SHARP_GAIA_DATA_DIR", str(Path(__file__).parent / "data")))
+
+# --- harness-pruning: system-prompt MODULES -------------------------------------
+# The OpenHands system prompt is a sequence of modules: a leading "intro" line plus
+# one <TAG>...</TAG> block per section. We prune by REMOVING modules from the
+# rendered full prompt (never rewriting) — this is both the search-space gate (each
+# module is a prunable component) and how the minimal prompt is produced.
+_PROMPT_TAGS = [
+    "ROLE", "MEMORY", "EFFICIENCY", "FILE_SYSTEM_GUIDELINES", "CODE_QUALITY",
+    "VERSION_CONTROL", "PULL_REQUESTS", "PROBLEM_SOLVING_WORKFLOW",
+    "SELF_DOCUMENTATION", "SECURITY", "SECURITY_RISK_ASSESSMENT", "BROWSER_TOOLS",
+    "EXTERNAL_SERVICES", "ENVIRONMENT_SETUP", "TROUBLESHOOTING", "PROCESS_MANAGEMENT",
+]
+
+
+def _prune_prompt_modules(full_text: str, keep: list) -> str:
+    """Return the full system prompt with only the kept modules (intro + <TAG>s)."""
+    blocks = []
+    first = re.search(r"<[A-Z_]+>", full_text)
+    intro = full_text[: first.start()].strip() if first else full_text.strip()
+    if "intro" in keep and intro:
+        blocks.append(intro)
+    for tag in _PROMPT_TAGS:
+        if tag in keep:
+            m = re.search(rf"(<{tag}>.*?</{tag}>)", full_text, flags=re.DOTALL)
+            if m:
+                blocks.append(m.group(1).strip())
+    return "\n\n".join(blocks).strip()
 
 
